{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "plugins": [
    {
      "path": "./rules/no-literal-jsx-text.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/*.test.*", "!**/*.spec.*", "!**/*.stories.*", "!**/__tests__/**", "!**/__mocks__/**"]
    },
    {
      "path": "./rules/no-literal-jsx-attribute.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/*.test.*", "!**/*.spec.*", "!**/*.stories.*", "!**/__tests__/**", "!**/__mocks__/**"]
    },
    {
      "path": "./rules/no-literal-ui-call.grit",
      "resolutionKind": "config",
      "includes": ["**", "!**/*.test.*", "!**/*.spec.*", "!**/*.stories.*", "!**/__tests__/**", "!**/__mocks__/**"]
    }
  ]
}
